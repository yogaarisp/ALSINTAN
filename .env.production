# Env untuk BUILD produksi (Vercel). Vite membakar nilai VITE_* ke dalam bundle
# saat `vite build`, jadi file ini yang membuat OAuth Google aktif di produksi.
#
# YANG BOLEH DI SINI: nilai publik saja (client ID OAuth, URL web app Apps Script,
# nama/versi aplikasi, flag fitur).
#
# YANG TIDAK BOLEH DI SINI — ini rahasia, tetap di Vercel (Settings > Environment
# Variables) atau hanya di .env.local mesin ini:
#   VITE_GAS_API_KEY
#   GOOGLE_SERVICE_ACCOUNT_JSON
#   SIAP_SPREADSHEET_ID
#   SIAP_DRIVE_FOLDER_ID

# Deployment Apps Script aktif (versi rename AO -> Analis, 27 Sep 2026)
VITE_GAS_API_URL=https://script.google.com/macros/s/AKfycbwXJIoF-m9yU84rBS9jqwDH9h9FFQEvo5aZb3GkhMvc9Kstj_Nu4JQ85e78lsy_C_c/exec

VITE_APP_NAME=SIAP ALSINTAN
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Sistem Informasi dan Analisis Potensi Alsintan
VITE_ENV=production

# Catatan: FEATURES belum dipakai di kode (lihat src/lib/config/app-config.ts),
# yang menentukan tampilnya tombol Google adalah VITE_GOOGLE_CLIENT_ID di bawah.
VITE_FEATURE_MAP=true
VITE_FEATURE_PRIORITY_SCORE=true
VITE_FEATURE_SURVEY_FORM=false
VITE_FEATURE_GOOGLE_OAUTH=true

# OAuth Client ID (Web application) — nilai publik, muncul di browser anyways
VITE_GOOGLE_CLIENT_ID=299078602913-opnv0655lnv0l585kbuns6gd7cvcigje.apps.googleusercontent.com
