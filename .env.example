# Environment variables template
# Copy this file to .env.local and fill in the values

# Google Apps Script API
# TODO: CONFIRM — URL deployment Apps Script yang sudah ada
VITE_GAS_API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
VITE_GAS_API_KEY=

# Application
VITE_APP_NAME=SIAP ALSINTAN
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Sistem Informasi dan Analisis Potensi Alsintan

# Environment
VITE_ENV=development

# Feature Flags
VITE_FEATURE_MAP=true
VITE_FEATURE_PRIORITY_SCORE=true
VITE_FEATURE_SURVEY_FORM=false
VITE_FEATURE_GOOGLE_OAUTH=false

# Google OAuth (Phase 1B+)
# VITE_GOOGLE_CLIENT_ID=your_google_client_id
